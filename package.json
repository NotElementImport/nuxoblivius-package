{
  "name": "nuxoblivius",
  "type": "module",
  "scripts": {
    "build:core": "npx tsc -p ./core/tsconfig.json",
    "build:backend-vue3": "npx tsc -p ./backend-vue3/tsconfig.json",
    "build:backend-react": "npx tsc -p ./core/tsconfig.json",
    "test:core": "node --test ./@test/test.core.js",
    "test:backend-vue3": "node --test ./@test/test.vue3.js",
    "test:backend-react": "node --test ./@test/test.react.js",
    "build": "npm run build:core; npm run build:backend-vue3",
    "test": "node --test ./@test/test.js",
    "start": "npm run build; npm test"
  },
