{
  "name": "nuxoblivius",
  "version": "1.7.18",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:core": "cd ./main && npx tsc -p ./tsconfig.json && cd ..",
    "build:backend:react": "cd ./backends/react/ && npx tsc -p ./tsconfig.json && cd ../..",
    "build:backend:vue3": "cd ./backends/vue3/ && npx tsc -p ./tsconfig.json && cd ../..",
    "build:backend:express": "cd ./backends/express/ && npx tsc -p ./tsconfig.json && cd ../..",
    "build:backend": "npm run build:backend:react && npm run build:backend:vue3 && npm run build:backend:express",
    "core": "npm test && npm run build:core",
    "backend": "npm test && npm run build:backend",
    "test": "npm run lint && vitest --run",
    "start": "npm test && npm run build:core && npm run build:backend",
    "link": "cd ./main && npm link && cd ../backends/react && npm link && cd ../vue3 && npm link && cd ../express && npm link && cd ../..",
    "publish:core": "cd ./main && npm publish --public",
    "lint": "npx eslint --format codeframe",
    "lint:fix": "npx eslint --fix"
  },
  "author": "notelementimport",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
